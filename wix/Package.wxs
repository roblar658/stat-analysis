<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="stat-analysis"
           Manufacturer="Robert Larsen"
           Version="0.1.0.0"
           UpgradeCode="7B91E4A2-3D5C-4A8F-9C2E-6E1F4A8B2D39"
           Scope="perUser"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="En nyere versjon av [ProductName] er allerede installert." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="wix\stat-analysis.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="wix\License.rtf" />

    <!-- Optional "Launch stat-analysis" checkbox on Finish page -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start stat-analysis" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#StatAnalysisExe]" />
    <CustomAction Id="LaunchApplication"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  BinaryRef="Wix4UtilCA_X86" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="stat-analysis">
          <Directory Id="ExamplesFolder" Name="examples" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="stat-analysis" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Main executable + user PATH -->
    <ComponentGroup Id="MainAppComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A4C2E118-52B1-4C94-8E73-11D29B5401A1">
        <File Id="StatAnalysisExe"
              Source="target\release\stat-analysis.exe" />
        <Environment Id="AddToUserPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="no" />
        <RegistryValue Root="HKCU"
                       Key="Software\Robert Larsen\stat-analysis"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="ReadmeDoc" Guid="B8F3D219-63C2-4D85-9F84-22E3AC6512B2">
        <File Id="ReadmeMd" Source="README.md" />
        <RegistryValue Root="HKCU"
                       Key="Software\Robert Larsen\stat-analysis"
                       Name="Readme"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- 10 Standard Example CSV Datasets -->
    <ComponentGroup Id="ExampleDatasets" Directory="ExamplesFolder">
      <Component Id="ExampleCsvFiles" Guid="C1010099-74D3-4E96-AF95-33F4BD762399">
        <File Source="examples\01_komplett_studie.csv" />
        <File Source="examples\02_normalfordeling_sma_utvalg.csv" />
        <File Source="examples\03_varians_grupper_welch.csv" />
        <File Source="examples\04_repeterte_maalinger_sfaerisitet.csv" />
        <File Source="examples\05_boligpriser_multikollinearitet.csv" />
        <File Source="examples\06_tidsserie_autokorrelasjon.csv" />
        <File Source="examples\07_inntekt_heteroskedastisitet.csv" />
        <File Source="examples\08_undersokelse_manglende_faktor.csv" />
        <File Source="examples\09_kreditt_logistisk_roc.csv" />
        <File Source="examples\10_klinisk_overlevelse_klynger.csv" />
        <RegistryValue Root="HKCU"
                       Key="Software\Robert Larsen\stat-analysis"
                       Name="Examples"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <RemoveFolder Id="RemoveExamplesFolder" Directory="ExamplesFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu & Desktop Shortcuts -->
    <ComponentGroup Id="ShortcutComponents">
      <Component Id="StartMenuShortcut"
                 Directory="ApplicationProgramsFolder"
                 Guid="D2020001-85E4-4FA7-B0A6-4405CE873401">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="stat-analysis"
                  Description="Statistisk Diagnostikk og Modellkvalitet"
                  Target="[#StatAnalysisExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="CleanUpStartMenuFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Robert Larsen\stat-analysis"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComp"
                 Directory="DesktopFolder"
                 Guid="D2020002-85E4-4FA7-B0A6-4405CE873402">
        <Shortcut Id="DesktopShortcut"
                  Name="stat-analysis"
                  Description="Statistisk Diagnostikk og Modellkvalitet"
                  Target="[#StatAnalysisExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\Robert Larsen\stat-analysis"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature"
             Title="stat-analysis"
             Description="Installerer stat-analysis, 10 standard eksempeldatasett og snarveier."
             Level="1">
      <ComponentGroupRef Id="MainAppComponents" />
      <ComponentGroupRef Id="ExampleDatasets" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

  </Package>
</Wix>
